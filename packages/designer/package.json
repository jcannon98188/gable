{
  "name": "@gable/designer",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "The Gable Designer: a Tauri shell (itself a Gable app), a Node backend, and the dev-only preview agent.",
  "bin": {
    "gable-designer": "./dist/server/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config shell/vite.config.ts",
    "dev:shell": "vite --config shell/vite.config.ts",
    "start": "node dist/server/cli.js"
  },
  "dependencies": {
    "@gable/core": "0.0.0",
    "@gable/language-service": "0.0.0",
    "@gable/renderer-dom": "0.0.0",
    "@gable/template-format": "0.0.0",
    "clsx": "^2.1.1",
    "lucide": "^1.70.0",
    "tailwind-merge": "^3.7.0",
    "@gable/ui-primitives": "0.0.0",
    "@typescript/typescript6": "^6.0.2",
    "@tailwindcss/node": "4.3.5"
  },
  "devDependencies": {
    "@gable/vite": "0.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.6"
  }
}
