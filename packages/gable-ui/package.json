{
  "name": "gable-ui",
  "version": "0.0.0",
  "description": "gable-ui CLI: copies gable-ui component source from a component registry into your project (init, add).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcannon98188/gable.git",
    "directory": "packages/gable-ui"
  },
  "bugs": {
    "url": "https://github.com/jcannon98188/gable/issues"
  },
  "homepage": "https://github.com/jcannon98188/gable/blob/main/docs/packages/gable-ui.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "gable-ui": "./dist/bin.js"
  },
  "files": [
    "dist",
    "registry"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node dist/bin.js build --ui ../ui --out registry"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
