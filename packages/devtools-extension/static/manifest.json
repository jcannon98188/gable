{
  "manifest_version": 3,
  "name": "Gable DevTools",
  "version": "0.0.0",
  "description": "Inspect Gable apps: component tree, signals and dependencies, effects, injectors and the router.",
  "minimum_chrome_version": "111",
  "devtools_page": "devtools.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "Gable DevTools",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }
  ]
}
