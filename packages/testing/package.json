{
  "name": "@gablejs/testing",
  "version": "0.0.0",
  "description": "Test harness for Gable components: mounts into an in-memory renderer, no jsdom or browser needed.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcannon98188/gable.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/jcannon98188/gable/issues"
  },
  "homepage": "https://github.com/jcannon98188/gable/blob/main/docs/packages/testing.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./a11y": {
      "types": "./dist/a11y.d.ts",
      "import": "./dist/a11y.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@gablejs/core": "0.0.0"
  },
  "peerDependencies": {
    "axe-core": "^4.10.0"
  },
  "peerDependenciesMeta": {
    "axe-core": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
