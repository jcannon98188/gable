      "types": "./client.d.ts"
    }
  },
  "files": [
    "dist",
    "client.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "magic-string": "^1.4.5"
  },
  "peerDependencies": {
    "@gable/core": "~0.0.0",
