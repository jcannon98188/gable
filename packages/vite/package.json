{
  "name": "@gable/vite",
  "version": "0.0.0",
  "description": "The Gable Vite plugins: dev-only HMR accept lines, forced native class fields, fail-fast tsconfig checks, i18n extraction and baking, and the service worker build step.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcannon98188/gable.git",
    "directory": "packages/vite"
  },
  "bugs": {
    "url": "https://github.com/jcannon98188/gable/issues"
  },
  "homepage": "https://github.com/jcannon98188/gable/blob/main/docs/packages/vite.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
