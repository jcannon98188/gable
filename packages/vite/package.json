    "@gable/core": "0.0.0",
    "@gable/renderer-dom": "0.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.0.0",
    "tailwindcss": "^4.3.4",
    "vite": "^8.3.6"
  },
  "peerDependenciesMeta": {
