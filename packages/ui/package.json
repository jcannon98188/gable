{
  "name": "@gable/ui",
  "version": "0.0.0",
  "description": "gable-ui: shadcn-style Tailwind components for Gable (buttons, forms, overlays, menus, navigation, data display).",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcannon98188/gable.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/jcannon98188/gable/issues"
  },
  "homepage": "https://github.com/jcannon98188/gable/blob/main/docs/packages/ui.md",
  "gablePack": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@gable/core": "0.0.0",
    "@gable/ui-primitives": "0.0.0",
    "@zag-js/combobox": "^1.47.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide": "^1.70.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@gable/renderer-dom": "0.0.0",
    "@gable/testing": "0.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
