{
  "name": "@gable/ui",
  "version": "0.0.0",
  "private": true,
  "gablePack": true,
  "description": "gable-ui: shadcn-style Tailwind components for Gable (buttons, forms, overlays, menus, navigation, data display).",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./theme.css"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@gable/core": "0.0.0",
    "@gable/ui-primitives": "0.0.0",
    "@zag-js/combobox": "^1.47.0",
    "clsx": "^2.1.1",
    "lucide": "^1.70.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@gable/renderer-dom": "0.0.0",
    "@gable/testing": "0.0.0"
  }
}
