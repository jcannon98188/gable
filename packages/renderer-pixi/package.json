{
  "name": "@gablejs/renderer-pixi",
  "version": "0.0.0",
  "description": "Gable canvas renderer on PixiJS: scene elements, hit areas, gestures, assets, particles and accessibility mirroring.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcannon98188/gable.git",
    "directory": "packages/renderer-pixi"
  },
  "bugs": {
    "url": "https://github.com/jcannon98188/gable/issues"
  },
  "homepage": "https://github.com/jcannon98188/gable/blob/main/docs/canvas.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    },
    "./elements": {
      "types": "./dist/elements.d.ts",
      "import": "./dist/elements.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "soak": "vitest run --config soak/vitest.config.ts",
    "golden": "node golden/run.mjs",
    "golden:update": "node golden/run.mjs --update"
  },
  "peerDependencies": {
    "@gablejs/core": "~0.0.0",
    "pixi.js": "^8.0.0",
    "@gablejs/testing": "~0.0.0"
  },
  "devDependencies": {
    "@gablejs/core": "0.0.0",
    "pixi.js": "^8.23.0",
    "@gablejs/testing": "0.0.0"
  },
  "peerDependenciesMeta": {
    "@gablejs/testing": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
