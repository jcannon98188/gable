{
  "name": "create-gable",
  "version": "0.1.0",
  "description": "npm create gable: copies the Gable starter template into a new project directory.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcannon98188/gable.git",
    "directory": "packages/create-gable"
  },
  "bugs": {
    "url": "https://github.com/jcannon98188/gable/issues"
  },
  "homepage": "https://github.com/jcannon98188/gable/blob/main/docs/packages/create-gable.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "create-gable": "./dist/bin.js"
  },
  "files": [
    "dist",
    "template",
    "template-service-worker"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "sync-docs": "node scripts/sync-docs.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
