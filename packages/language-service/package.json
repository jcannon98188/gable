{
  "name": "@gablejs/language-service",
  "version": "0.1.0",
  "description": "Gable template analyzer: type-checks html templates against component classes. Ships the tsserver plugin (main) and the gable-check CLI.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jcannon98188/gable.git",
    "directory": "packages/language-service"
  },
  "bugs": {
    "url": "https://github.com/jcannon98188/gable/issues"
  },
  "homepage": "https://github.com/jcannon98188/gable/blob/main/docs/packages/language-service.md",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "gable-check": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node build-plugin.mjs"
  },
  "dependencies": {
    "@gablejs/core": "0.1.0",
    "@gablejs/renderer-pixi": "0.1.0",
    "@typescript/typescript6": "^6.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "rolldown": "^1.2.16"
  },
  "main": "./dist/plugin.cjs",
  "publishConfig": {
    "access": "public"
  }
}
