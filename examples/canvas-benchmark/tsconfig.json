{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "useDefineForClassFields": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "paths": {
      "@gablejs/core": ["../../packages/core/src/index.ts"],
      "@gablejs/renderer-dom": ["../../packages/renderer-dom/src/index.ts"],
      "@gablejs/renderer-pixi": ["../../packages/renderer-pixi/src/index.ts"]
    }
  },
  "include": ["src", "microbench", "vite.config.ts"]
}
