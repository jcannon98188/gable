{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "types": ["node"],
    "paths": {
      "@gablejs/core": ["./packages/core/src/index.ts"],
      "@gablejs/core/*": ["./packages/core/src/*.ts"],
      "@gablejs/testing": ["./packages/testing/src/index.ts"],
      "@gablejs/testing/*": ["./packages/testing/src/*.ts"],
      "@gablejs/ui-primitives": ["./packages/ui-primitives/src/index.ts"],
      "@gablejs/ui-primitives/testing": ["./packages/ui-primitives/src/testing.ts"],
      "@gablejs/ui": ["./packages/ui/src/index.ts"],
      "@gablejs/store": ["./packages/store/src/index.ts"],
      "@gablejs/service-worker": ["./packages/service-worker/src/index.ts"],
      "@gablejs/service-worker/core": ["./packages/service-worker/src/core/index.ts"],
      "@gablejs/service-worker/runtime": ["./packages/service-worker/src/runtime/index.ts"],
      "@gablejs/renderer-dom": ["./packages/renderer-dom/src/index.ts"],
      "@gablejs/renderer-pixi": ["./packages/renderer-pixi/src/index.ts"],
      "@gablejs/renderer-pixi/*": ["./packages/renderer-pixi/src/*.ts"],
      "@gablejs/template-format": ["./packages/template-format/src/index.ts"],
      "@gablejs/prettier-plugin": ["./packages/prettier-plugin/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.test.ts", "packages/*/src/**/*.test.tsx"]
}
